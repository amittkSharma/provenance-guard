{
  "name": "@amittksharma/provenance-guard",
  "version": "0.1.0",
  "description": "Catch compromised npm releases before they reach your build: fails CI when a dependency update loses provenance, is built from a different repository, adds an install script or comes from a new publisher. npm, pnpm, Yarn and monorepos; SARIF, JUnit, HTML and Markdown reports.",
  "keywords": [
    "supply-chain-security",
    "software-supply-chain",
    "npm-security",
    "dependency-security",
    "provenance",
    "slsa",
    "sigstore",
    "trusted-publishing",
    "lockfile",
    "npm",
    "pnpm",
    "yarn",
    "monorepo",
    "devsecops",
    "sarif",
    "junit",
    "github-actions",
    "azure-devops",
    "ci",
    "cli"
  ],
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "Amitt K Sharma",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amittkSharma/provenance-guard.git"
  },
  "homepage": "https://github.com/amittkSharma/provenance-guard#readme",
  "bugs": {
    "url": "https://github.com/amittkSharma/provenance-guard/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "provenance-guard": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc --project tsconfig.json",
    "bump": "commit-and-tag-version --dry-run | grep -q \"^[*-] \" && commit-and-tag-version || echo \"No changes\"",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "prepare": "husky",
    "prepublishOnly": "npm run lint && npm run types && npm test && npm run build",
    "test": "node --test --experimental-strip-types --no-warnings \"test/**/*.test.ts\"",
    "types": "tsc --noEmit -p tsconfig.test.json"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@types/node": "^22.20.5",
    "commit-and-tag-version": "^13.4.0",
    "husky": "^9.1.7",
    "typescript": "^7.0.2"
  }
}
